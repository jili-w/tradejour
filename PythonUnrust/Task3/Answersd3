#2.  Simulate a price level: create a deque, append orders ("o1", 10), ("o2", 5), ("o3", 8) as (id, qty) in arrival order, 
# then serve them first come, first served by popping and printing each until the deque is empty. (Hint: while q: loops as long as the deque isn’t empty.)

q = deque()
orders = [("o1", 10), ("o2", 5), ("o3", 8)]
for order in orders:
    q.append(order)

while q:
    order_id,qty = q.popleft() 
    print(f"Filled {order_id} for {qty}")

