#4. Build a mini book side: a defaultdict(deque) where each key is a price and each value is a queue of orders. Add ("o1", 10) and ("o2", 5) at price 100, 
#and ("o3", 7) at price 101. Then print the total quantity resting at each price. (Hint: a sum(...) over a comprehension.)

book_side = defaultdict(deque)
book_side[100].append(("o1", 10))
book_side[100].append(("o2", 5))
book_side[101].append(("o3", 7))
for prices,orders in book_side.items():
    total = sum(qty for t,qty in orders)
    print(f"{prices} : {total}")

